# Frontend environment (read by Vite at build time; only VITE_* names reach the browser).

# Where the PaperMind API lives, without a trailing slash and without /api.
# Leave empty in development: the Vite dev server proxies /api to http://localhost:8000.
# For a Vercel deploy whose API runs elsewhere (EC2), set it in the Vercel project settings,
# e.g. VITE_API_ORIGIN=https://api.papermind.example. vercel.json can't rewrite /api to a
# per-environment origin, so the origin is compiled into the bundle instead. The API must
# list the Vercel origin in its CORS_ORIGINS setting.
VITE_API_ORIGIN=

# Upload limit in MB, shown under the add field and checked before uploading.
# Keep it equal to the server's MAX_UPLOAD_MB. Defaults to 50.
VITE_MAX_UPLOAD_MB=

# Dev and preview servers only: where /api is proxied to. Defaults to http://localhost:8000.
PAPERMIND_API_PROXY=
