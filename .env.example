# PaperMind configuration. Copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is gitignored. Never commit real keys.

# ─── Hosted model (agent reasoning) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Exact model id — do NOT append a date suffix.
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Controls thinking depth and token spend.
# `high` is the default; drop to `medium` for cheap loop iterations.
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=16000
# Prompt-cache TTL for the paper-content breakpoint: 5m (default) or 1h.
# 1h doubles write cost and needs 3+ reads to break even — measure first.
ANTHROPIC_CACHE_TTL=5m

# ─── Local explanation model ───────────────────────────────────────────────────
LOCAL_MODEL_PATH=./models/papermind-mistral-7b
LOCAL_MODEL_DEVICE=cuda                 # cuda | mps | cpu
# Concurrent generations. One set of weights lives in VRAM; >1 usually OOMs or
# thrashes. Raise only if you have measured headroom.
LOCAL_MODEL_MAX_CONCURRENCY=1
# If no accelerator is available, fall back to the hosted model for the final
# explanation. Always recorded in the trace — a silent fallback voids eval runs.
LOCAL_MODEL_FALLBACK_TO_HOSTED=true

# ─── Retrieval ─────────────────────────────────────────────────────────────────
PAPERS_DIR=data/papers
EMBEDDING_MODEL=all-MiniLM-L6-v2
# RRF smoothing constant from Cormack et al. NOT the number of results — see
# RETRIEVAL_TOP_K for that. Conflating the two is a silent bug.
RRF_K=60
RETRIEVAL_TOP_K=5
# Build every ingested paper's index during startup. Off = the first request
# for a paper pays the build cost instead.
WARM_INDEXES_AT_STARTUP=true

# ─── Redis (session state, 24h TTL) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400

# ─── Neo4j (concept graph, persistent) ─────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Must match NEO4J_AUTH in docker-compose.yml.
NEO4J_PASSWORD=papermind-dev
NEO4J_DATABASE=neo4j

# ─── Semantic Scholar ──────────────────────────────────────────────────────────
# Optional. Without a key you are on the shared anonymous rate limit (~1 req/s),
# which is enough for local development and not for the eval harness.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=10

# ─── Evaluation ────────────────────────────────────────────────────────────────
WANDB_API_KEY=
WANDB_PROJECT=papermind
WANDB_ENTITY=
# Set to "offline" to run the harness without network access.
WANDB_MODE=online

# ─── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Vite dev server origin, for CORS.
FRONTEND_ORIGIN=http://localhost:5173
# Hard stops for the ReAct loop. Prerequisite-gap chasing can otherwise walk the
# concept graph indefinitely.
AGENT_MAX_ITERATIONS=12
AGENT_MAX_TOKENS_PER_TURN=100000
