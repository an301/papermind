# Copy to .env and fill in. Every setting is read in papermind/config.py; the
# names below are the upper-case field names there.

# ---- required for answering questions
ANTHROPIC_API_KEY=

# ---- model (defaults shown)
# MODEL=claude-opus-5-5
# AGENT_EFFORT=low          # tool routing: which tool next?
# WRITER_EFFORT=low         # the explanation the reader sees
# CLASSIFIER_EFFORT=low     # mastery + follow-ups pass
# ENABLE_FALLBACKS=true     # server-side refusal fallback (beta)

# ---- latency switches (the eval harness flips these for the A/B)
# PARALLEL_TOOLS=true
# PROMPT_CACHING=true
# PREWARM_CACHE=true

# ---- services
# REDIS_URL=redis://localhost:6379/0
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=papermind-dev

# ---- MCP servers: stdio (spawned by the API) or http (separate services)
# MCP_TRANSPORT=stdio
# MCP_RETRIEVER_URL=http://127.0.0.1:8101/mcp
# MCP_PREREQ_URL=http://127.0.0.1:8102/mcp
# MCP_SCHOLAR_URL=http://127.0.0.1:8103/mcp

# ---- the fine-tuned writer (see training/README.md)
# WRITER_BACKEND=claude     # or mistral
# MISTRAL_BASE_URL=http://localhost:8001/v1
# MISTRAL_MODEL=papermind   # the LoRA module name; the base model id gives the untuned baseline

# ---- optional
# S2_API_KEY=               # Semantic Scholar key: higher rate limits
# CORS_ORIGINS=["http://localhost:5173"]
# WANDB_MODE=offline        # online to stream eval runs to wandb.ai
# WANDB_PROJECT=papermind
